# Copy this file to .env and fill in what you need. .env is gitignored.
# NEVER put real credentials in this file -- it is tracked by git.
# Every value can also be set in the environment, which takes precedence.

# ---- API keys --------------------------------------------------------------
# OpenAI: the knowledge stream (data_processing/knowledge/generate_rag_cache.py)
# and the LLM baselines (script/run.sh llm)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Anthropic: rag_method=5 and the Claude baselines
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# HuggingFace: only needed if the dataset repository is private
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Paths (defaults shown; relative paths are read from the repository root) ----
# Defined in data_processing/config.py, which every script and script/run.sh read.
# DATA_DIR=data/Ukiyoe1000            # txt/ xml/ cv/ ukiyoe_picture/ Ukiyoe1000_VinVL/
# MODEL_DIR=download_model            # bart-large-japanese/, detectors/
# SAVE_DIR=saved_model                # checkpoints and prediction dumps
# LOG_DIR=log
# FIGURE_DIR=figure
# BASELINE_DIR=baselines             # third-party baseline ports; run.sh skips a baseline not found here
# KNOWLEDGE_FILE=saved_model/gpt_ner_res_sol_v2.txt   # LLM knowledge cache (rag_method=1)

# ---- Download source (script/download.py) ----------------------------------
# HF_DATA_REPO=BohaoWu/Ukiyoe_MNERG     # dataset repository
# HF_MODEL_REPO=BohaoWu/NERGL           # trained weights
